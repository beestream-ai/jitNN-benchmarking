<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ai.beestream.jitnn.bench</groupId>
    <artifactId>djl-bench</artifactId>
    <version>1</version>
    <name>DJL side of the jitNN inference comparison</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <djl.version>0.38.0</djl.version>
        <!-- onnxruntime_gpu on x86-64; on aarch64 a locally built sm_80 jar installed under this name -->
        <ort.artifact>onnxruntime_gpu</ort.artifact>
        <ort.version>1.30.0</ort.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>api</artifactId>
            <version>${djl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
        </dependency>
    </dependencies>

    <!-- One engine per run (-Port or -Ppytorch): DJL starts every engine on the classpath, and their native libraries clash. -->
    <profiles>
        <profile>
            <id>ort</id>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.onnxruntime</groupId>
                    <artifactId>onnxruntime-engine</artifactId>
                    <version>${djl.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>com.microsoft.onnxruntime</groupId>
                            <artifactId>onnxruntime</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>${ort.artifact}</artifactId>
                    <version>${ort.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>pytorch</id>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.pytorch</groupId>
                    <artifactId>pytorch-engine</artifactId>
                    <version>${djl.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>bench.Bench</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
